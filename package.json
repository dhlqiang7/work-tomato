{
  "name": "tomato",
  "version": "1.0.0",
  "description": "个人工作跟踪与番茄钟系统",
  "author": "",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "start:electron": "electron .",
    "electron:dev": "vite build && electron .",
    "electron:build": "vite build && electron-builder",
    "preview": "vite preview",
    "install:verbose": "npm install --verbose"
  },
  "dependencies": {
    "express": "^4.0.0",
    "marked": ">=17.0.6",
    "mermaid": ">=10.0.0",
    "uuid": ">=9.0.0",
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "electron": ">=28.0.0",
    "electron-builder": ">=24.0.0",
    "vite": "^5.0.0 || ^6.0.0"
  },
  "overrides": {
    "@electron/node-gyp": ">=10.2.0-electron.1"
  },
  "build": {
    "appId": "com.tomato.work",
    "productName": "Tomato",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**",
      "electron/**",
      "server/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "data",
        "to": "data",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Tomato"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "electron/icon.png",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "electron/icon.png",
      "category": "Utility"
    }
  }
}
